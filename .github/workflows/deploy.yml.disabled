# DISABLED 2026-07-11: superseded by kineticgain-com-apex's consolidated
# deploy.yml, which now checks out mizcausevic-dev/portfolio-command-center
# and deploys it to this exact same target (portfolio.kineticgain.com) —
# confirmed via apex's deploy.yml (checkout step + upload path both match).
# This repo's own copy has been failing since 2026-06-14 with "FTPError: 530
# Login incorrect" against a deploy path apex already owns; fixing the stale
# credential here would just create two writers racing the same subdomain.
# Re-enable (rename back to deploy.yml) only if portfolio-constellation
# becomes the source of truth for portfolio.kineticgain.com again.
name: Deploy to Hostinger

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    name: FTP-sync built dashboard to portfolio.kineticgain.com
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6

      - uses: actions/setup-node@v6
        with:
          node-version: "20"
          cache: npm

      - name: Install
        run: npm ci

      - name: Build
        run: npm run build

      - name: Verify build output
        run: |
          test -f dist/index.html || (echo "FAIL: dist/index.html missing" && exit 1)
          grep -q "Portfolio Constellation" dist/index.html || \
            (echo "FAIL: dist/index.html missing brand string" && exit 1)
          echo "OK: build verified"
          ls -lah dist/

      - name: FTP-Deploy dist/ to /portfolio/ (first attempt)
        id: deploy
        timeout-minutes: 5
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        continue-on-error: true
        with:
          server: ${{ secrets.FTP_HOST }}
          username: ${{ secrets.FTP_USER }}
          password: ${{ secrets.FTP_PASS }}
          protocol: ftps
          port: 21
          timeout: 60000
          local-dir: ./dist/
          server-dir: /portfolio/
          dangerous-clean-slate: false
          log-level: standard
          exclude: |
            **/.DS_Store

      - name: Sleep before retry (let FTP cap drain)
        if: steps.deploy.outcome == 'failure'
        run: sleep 60

      - name: Retry FTP-Deploy if first attempt failed
        if: steps.deploy.outcome == 'failure'
        timeout-minutes: 5
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_HOST }}
          username: ${{ secrets.FTP_USER }}
          password: ${{ secrets.FTP_PASS }}
          protocol: ftps
          port: 21
          timeout: 90000
          local-dir: ./dist/
          server-dir: /portfolio/
          dangerous-clean-slate: false
          log-level: verbose
          exclude: |
            **/.DS_Store
